# Copy to .env and change every secret before any shared deployment.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://regulens:regulens@localhost:5432/regulens
SECRET_KEY=change-me-to-64-random-hex-characters
AUDIT_SIGNING_KEY=change-me-separately-from-secret-key
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=60
LOGIN_RATE_PER_MIN=30

# Storage: local (dev) or s3 (MinIO / S3-compatible, server-side encryption on)
STORAGE_BACKEND=local
STORAGE_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=regulens
S3_ACCESS_KEY=regulens
S3_SECRET_KEY=regulens-secret
MAX_UPLOAD_MB=15
AUDIT_ANCHOR_DIR=./infra/audit-anchor

# Malware scanning: set CLAMD_HOST to use ClamAV; empty = clearly-labelled local signature fallback
CLAMD_HOST=
CLAMD_PORT=3310

# Approval-letter extraction: local (rule-based, no LLM) or anthropic (needs a key)
LLM_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Notifications: empty SMTP_HOST = development mailbox capture; SMS/WhatsApp use dev adapters until credentials exist
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=noreply@regulens.local
SMS_PROVIDER=devlog
WHATSAPP_PROVIDER=devpreview

RUN_SCHEDULER=1
SCHEDULER_TICK_SECONDS=15
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
